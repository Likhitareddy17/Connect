# ── Flask ────────────────────────────────────────────────────────────────────
# REQUIRED. The app refuses to start without it (unless FLASK_DEBUG=1).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-secret
# Local development only: enables debug mode and allows an ephemeral secret key.
FLASK_DEBUG=0
# Session cookies are Secure (HTTPS-only) unless FLASK_DEBUG=1. Set to 0 only when
# testing over plain http without debug mode (e.g. docker run on localhost).
# COOKIE_SECURE=0
# Set to 1 behind a reverse proxy (Render, Heroku, nginx) so client IPs and
# https are read from X-Forwarded-* headers.
TRUST_PROXY=0

# ── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=connect_mvp
MYSQL_POOL_SIZE=5

# ── Groq (LLM for the emotional chat) ────────────────────────────────────────
# Without a key the chat still works but returns a fixed fallback message
# (and records no mood). Free key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# ── Prokerala Panchang API (optional) ────────────────────────────────────────
# Falls back to local data if absent. The free plan only answers for Jan 1st, so
# live data is used only on that date. Set PROKERALA_FREE_TIER=0 on a paid plan.
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=
PROKERALA_FREE_TIER=1
# Panchang location (defaults to Hyderabad)
PANCHANG_LAT=17.385
PANCHANG_LON=78.4867
PANCHANG_AYANAMSA=1

# ── Rate limiter ─────────────────────────────────────────────────────────────
# memory:// is per-process; use redis://... with more than one worker.
LIMITER_STORAGE_URI=memory://

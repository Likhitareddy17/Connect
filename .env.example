# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=connect_mvp
MYSQL_POOL_SIZE=5

# Groq — required for the emotional chat companion to reply with real
# generated text. Without it, the chat still works but returns a fixed
# "not able to respond fully right now" message.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Prokerala Panchang API — optional; falls back to mock data if absent
# Sign up at https://api.prokerala.com/
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=

# Panchang location (defaults to Hyderabad)
PANCHANG_LAT=17.385
PANCHANG_LON=78.4867
PANCHANG_AYANAMSA=1

# Rate limiter — set to redis://... in production, leave as memory:// for local dev
LIMITER_STORAGE_URI=memory://
